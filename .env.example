# ===== Ombre Brain 手机版配置模板 =====
# 用法：复制成 .env，把两个 change-me 换成真实 Key（nano 里 Ctrl+X → Y 保存）
# 说明：本文件没有真实密钥，公开也安全。

# --- DeepSeek：记忆打标/脱水模型（国内直连）---
OMBRE_COMPRESS_API_KEY=change-me
OMBRE_COMPRESS_BASE_URL=https://api.deepseek.com/v1
OMBRE_COMPRESS_MODEL=deepseek-chat

# --- 硅基流动：向量化 embedding（DeepSeek 没有，必须用它）---
# 免费注册：https://siliconflow.cn
OMBRE_EMBED_API_KEY=change-me
OMBRE_EMBED_BASE_URL=https://api.siliconflow.cn/v1
OMBRE_EMBED_MODEL=BAAI/bge-m3

# --- 手机本地连接方式（不要改）---
OMBRE_TRANSPORT=streamable-http
OMBRE_BIND_HOST=127.0.0.1
OMBRE_MCP_REQUIRE_AUTH=false
